{
  "kind": "nodejs-language-checklist",
  "schema_version": 1,
  "language": "nodejs",
  "coverage_note": "Human-maintained language-core checklist seed. Keep protocol and idiom judgment here, not in generated stdlib files.",
  "entries": [
    {
      "id": "language.modules",
      "title": "Use CommonJS and ES module boundaries",
      "covers": [
        "require",
        "import",
        "module.exports",
        "export"
      ],
      "cases": [
        "load a built-in module by node: specifier",
        "separate default/named exports from CommonJS exports"
      ],
      "status": "todo",
      "test_files": []
    },
    {
      "id": "language.event-loop",
      "title": "Understand event loop scheduling",
      "covers": [
        "Promise",
        "queueMicrotask",
        "setImmediate",
        "setTimeout",
        "process.nextTick"
      ],
      "cases": [
        "distinguish microtasks from timers",
        "avoid examples that depend on wall-clock sleeps"
      ],
      "status": "todo",
      "test_files": []
    },
    {
      "id": "language.buffers",
      "title": "Handle binary data and encodings",
      "covers": [
        "Buffer",
        "Uint8Array",
        "TextEncoder",
        "TextDecoder"
      ],
      "cases": [
        "convert between strings and bytes",
        "avoid mutating shared buffers accidentally"
      ],
      "status": "todo",
      "test_files": []
    },
    {
      "id": "language.errors",
      "title": "Use Node error and assertion conventions",
      "covers": [
        "Error",
        "AggregateError",
        "assert.AssertionError"
      ],
      "cases": [
        "throw and catch expected errors",
        "assert failure metadata is inspectable"
      ],
      "status": "todo",
      "test_files": []
    },
    {
      "id": "language.streams",
      "title": "Use stream/event protocols",
      "covers": [
        "stream.Readable",
        "stream.Writable",
        "EventEmitter"
      ],
      "cases": [
        "consume readable data events",
        "prefer promise helpers where available"
      ],
      "status": "todo",
      "test_files": []
    }
  ]
}
