      "target": "fmt",
      "title": "Format values and build strings",
      "covers": [
        "fmt.Sprintf",
        "fmt.Println",
        "strings.Builder",
        "strings.Builder.WriteString",
        "strings.Builder.String"
      ],
      "cases": [
        "Sprintf formats without writing to stdout",
        "Builder accumulates strings efficiently"
      ],
      "suggested_test_files": [
        "languages/go/stdlib/fmt_strings_test.go"
      ],
      "status": "todo",
      "test_files": []
    },
    {
